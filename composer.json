{
    "name": "volaitan/trades-booking-system",
    "description": "Online booking, quotes and invoicing for tradespeople. Plain PHP 8.2 + PDO (MySQL or SQLite).",
    "type": "project",
    "license": "MIT",
    "authors": [{ "name": "Victor Olaitan" }],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "setup": "php bin/setup.php",
        "serve": "php -S localhost:8080 -t public"
    }
}
